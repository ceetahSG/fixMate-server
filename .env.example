# Copy to .env and replace the placeholder values.

# MongoDB
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/?retryWrites=true&w=majority
MONGODB_DB_NAME=fixMateDb

# Server
PORT=5000

# Frontend origin. Also used as the JWT issuer/audience expected from BetterAuth,
# so it must match the frontend's BETTER_AUTH_URL.
FRONTEND_URL=http://localhost:3000

# Comma-separated list of allowed CORS origins (include localhost for development).
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# BetterAuth JWKS endpoint. A path is resolved against FRONTEND_URL;
# a full URL may also be used. Must match BetterAuth's jwksPath.
JWKS_PATH=/api/auth/jwks

# Stripe checkout redirect URLs (absolute URLs).
PAYMENT_SUCCESS_URL=http://localhost:3000/payment-success?session_id={CHECKOUT_SESSION_ID}
PAYMENT_CANCEL_URL=http://localhost:3000/payment-cancel

# Stripe
STRIPE_SECRET_KEY=sk_test_replace_me
